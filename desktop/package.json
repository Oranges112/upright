{
  "name": "upright-desktop",
  "productName": "Upright",
  "version": "1.2.2",
  "description": "Upright posture widget: a tiny always-on-top dot that warns you when you slouch.",
  "author": "Oranges112",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set UPRIGHT_URL=http://localhost:3000/&& electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "app.upright.desktop",
    "productName": "Upright",
    "files": [
      "main.js",
      "preload.js",
      "appPreload.js",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "Upright-Portable.exe"
    },
    "nsis": {
      "artifactName": "Upright-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Upright"
    },
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Upright",
        "schemes": [
          "upright"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Oranges112/upright/releases/latest/download"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
